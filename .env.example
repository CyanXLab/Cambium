# Cambium 环境变量（全部可选）
#
# 所有 API 配置（API key、模型名、base URL）都在前端设置页配置，
# 存储在 SQLite 数据库的 settings 表中，不依赖 .env 文件。
#
# 本文件仅用于可选的日志和启动参数覆盖。

# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
CAMBIUM_LOG_LEVEL=INFO

# 日志格式（human = 开发可读，json = 生产结构化）
CAMBIUM_LOG_FORMAT=human

# 可选：日志文件路径（留空 = 仅 stdout）
# CAMBIUM_LOG_FILE=logs/cambium.log

# 可选：覆盖默认 embedding 模型（需要 pip install sentence-transformers）
# CAMBIUM_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 可选：监听端口（默认 3000）
PORT=3000
