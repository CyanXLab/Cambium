# Cambium 环境变量
# 复制此文件为 .env 并修改为你自己的 API 配置

# ModelScope API（需自行注册获取）
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 推荐使用真实存在的模型，例如：
# Qwen/Qwen3-235B-A22B-Instruct-2507
# Qwen/Qwen3-30B-A3B-Instruct-2507
# Qwen/Qwen2.5-72B-Instruct
MODELSCOPE_MODEL=

# 端口
PORT=3000

# 日志配置（可选）
CAMBIUM_LOG_LEVEL=INFO
CAMBIUM_LOG_FORMAT=human
# CAMBIUM_LOG_FILE=logs/cambium.log
